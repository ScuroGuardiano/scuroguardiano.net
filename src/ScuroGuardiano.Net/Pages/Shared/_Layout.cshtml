<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - scuroguardiano.net</title>

    <script type="module" src="~/lib/datastar.min.js"></script>
    <script type="importmap"></script>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/ScuroGuardiano.Net.styles.css" asp-append-version="true"/>


    <style>
    </style>
</head>
<body data-on:popstate__window="@@get(location.pathname + location.search)">
<div class="layout">
    @await Html.PartialAsync("_Header")

    <main role="main" class="layout-main">
        @RenderBody()
    </main>

    <footer class="border-top footer">
        <div class="container">
            &copy; 2026 - ScuroGuardiano
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", false)
</div>
</body>
</html>
